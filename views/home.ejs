<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
   <div class="container mt-4">
    <div class="card shadow rounded-4 border-4">
        <div class="card-body">
            <div class="text-center text-primary">
                <h2>Employee List</h2>

            </div>
            <div class="d-flex justify-content-end mb-3">
                <a class="btn btn-primary" href="/add-emp">
                    <i class="bi bi-person-add"></i>  Add New Employee</a>
            </div>
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Sr. Number</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% var sno=1 %>
                    <% employees.forEach(emp=>{ %>

                   
                   
                    <tr>
                        <td><%= sno++ %></td>
                        <td><%= emp.fname %></td>
                        <td><%= emp.lname %></td>
                        <td><%= emp.email %></td>
                        <td><%= emp.phone %></td>
                        <td>
                           <a class="text-info" href="/show-emp/<%= emp._id %>" title="Show">
                             <i class="bi bi-eye-fill"></i>
                           </a>
                           <a class="text-warning" href="/update-emp/<%= emp._id %>" title="Edit">
                            <i class="bi bi-pencil-fill"></i>
                           </a>
                           <a class="text-danger" href="/delete-emp/<%= emp._id %>" title="Delete">
                            <i class="bi bi-trash-fill"></i>
                           </a>

                        </td>
                    </tr>
                    <% }) %> 
                </tbody>
            </table>

        </div>

    </div>

   </div>
</body>
</html>
